.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.example # We keep example but user should use .env
ScamShieldBackend/.env
Email-Scam-Shield/.env

# IDE / System
.DS_Store
.vscode/
.idea/
*.swp
*.swo
.project
.classpath
.settings/
desktop.ini

# Build Artifacts
build/
server_dist/
*.tsbuildinfo
.vercel

# Project Specific
